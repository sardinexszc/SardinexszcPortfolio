SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ to these values.
SUPABASE_SECRET_KEY=
SUPABASE_ADMIN_USER_ID=

# Shop (server only). PayMongo: Developers > API keys, and Developers > Webhooks for
# https://<your-site>/api/payments/paymongo/webhook with the event checkout_session.payment.paid.
# Use the sk_test_ key until a real ₱20 test purchase works, then switch to sk_live_ and the live webhook secret.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Receipt emails through Resend. SHOP_FROM_EMAIL must be on a domain verified in Resend, e.g. "Ivan Salinas <shop@yourdomain.com>".
RESEND_API_KEY=
SHOP_FROM_EMAIL=
# Optional: signs download links. Defaults to SUPABASE_SECRET_KEY; changing it invalidates existing links.
SHOP_TOKEN_SECRET=
